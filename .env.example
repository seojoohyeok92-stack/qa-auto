# Naver credentials (leave secrets empty in source control)
OJE_AUTOMATION_DB_PATH=data/oje_automation.db
# Separate READ-ONLY Product Knowledge database. Never written or migrated by
# this project. Defaults to data/product_facts.db when unset; product facts are
# simply unavailable if the file is missing.
OJE_PRODUCT_FACTS_DB_PATH=
DEFAULT_STORE_CODE=OJE_PLUS
OJE_PLUS_ENABLED=true
OJE_PLUS_STORE_NAME=오제플러스
OJE_PLUS_CLIENT_ID=
OJE_PLUS_CLIENT_SECRET=
SMART_STORE_ENABLED=true
SMART_STORE_NAME=스마트스토어
SMART_STORE_CLIENT_ID=
SMART_STORE_CLIENT_SECRET=

# Version 1.1 read-only inquiry synchronization
NAVER_SYNC_ENABLED=false
NAVER_SYNC_LOOKBACK_DAYS=7
AUTO_POST_UNCHANGED_LEARNING_DAYS=7
HISTORICAL_IMPORT_WINDOW_DAYS=90
NAVER_SYNC_PAGE_SIZE=100
NAVER_SYNC_MAX_PAGES=100
NAVER_SYNC_CONNECT_TIMEOUT=5
NAVER_SYNC_READ_TIMEOUT=20
NAVER_SYNC_MAX_RETRIES=2
NAVER_SYNC_RETRY_BACKOFF=0.5
NAVER_SYNC_MAX_RUNTIME_SECONDS=120
NAVER_SYNC_LOCK_TTL_SECONDS=300
NAVER_AUTO_SYNC_ENABLED=false
NAVER_AUTO_SYNC_INTERVAL_MINUTES=10

# Version 1.3 manual Naver answer posting (disabled by default)
NAVER_POST_ENABLED=false
NAVER_POST_CONNECT_TIMEOUT=5
NAVER_POST_READ_TIMEOUT=20
NAVER_AUTO_POST_ENABLED=false
NAVER_AUTO_POST_INTERVAL_MINUTES=10
NAVER_AUTO_POST_MAX_RETRIES=1
# AUTO_PROCESSING_ENABLED is intentionally not an env key. The Dashboard
# stores the server-wide operator switch in the application database.

# DPS Windows Agent session monitoring (no credentials or automatic login)
DPS_AGENT_HOST=127.0.0.1
DPS_AGENT_PORT=8765
DPS_ALLOWED_HOSTS=dps2u.co.kr
DPS_CONNECT_TIMEOUT_SECONDS=7
DPS_READ_TIMEOUT_SECONDS=100
DPS_TOTAL_TIMEOUT_SECONDS=120
DPS_SUCCESS_CACHE_TTL_SECONDS=1800
DPS_NOT_FOUND_CACHE_TTL_SECONDS=300
DPS_REFRESH_INTERVAL_MINUTES=30
DPS_SESSION_IDLE_SECONDS=3600
DPS_CACHE_TTL_SECONDS=600
DPS_LOOKUP_JOB_TTL_SECONDS=900
DPS_LOOKUP_JOB_MAX_ITEMS=100
# Optional override; blank keeps the repository-local ignored state path.
DPS_CONNECTION_FILE=
DPS_SESSION_MONITOR_ENABLED=true
DPS_SESSION_KEEPALIVE_ENABLED=true
DPS_SESSION_MONITOR_INTERVAL_SECONDS=60
DPS_SESSION_KEEPALIVE_INTERVAL_MINUTES=40
# Preferred name: idle threshold since the monitor checks every minute and
# only clicks the authenticated DPS control after this much real DPS inactivity.
DPS_SESSION_IDLE_MINUTES=40
DPS_SESSION_KEEPALIVE_URGENT_MINUTES=55
# Failed automatic GUI keep-alive attempts must not steal foreground every
# five minutes. Manual force-keepalive can still bypass this cooldown.
DPS_SESSION_KEEPALIVE_RETRY_COOLDOWN_MINUTES=40
DPS_PASSIVE_IDLE_ENABLED=true
DPS_PASSIVE_SESSION_MONITOR_ENABLED=true
DPS_ON_DEMAND_CONNECT_ENABLED=true

# DPS low-priority coexistence with other Windows GUI automation
DPS_GUI_GUARD_ENABLED=true
DPS_GUI_GUARD_RECHECK_SECONDS=5
DPS_GUI_GUARD_COOLDOWN_SECONDS=5
DPS_GUI_RESOURCE_MAX_WAIT_SECONDS=600
DPS_GUI_GUARD_ACTIVITY_GRACE_SECONDS=15
# Resident processes are not considered busy. Process patterns match only the
# process that owns the current foreground window.
DPS_GUI_GUARD_PROCESS_PATTERNS=
DPS_GUI_GUARD_WINDOW_PATTERNS=KakaoTalk,카카오톡

# 답변 생성 완료 시 common_service/kakao 공통 대기열로 알림을 보냅니다.
KAKAO_NOTIFY_ENABLED=1
KAKAO_QNA_RECIPIENT=오제 네이버 자동답변 확인방
# Comma-separated marker paths; relative paths are resolved from qa-auto.
DPS_GUI_GUARD_ACTIVITY_PATHS=

# GPT governance (keep FAKE until provider use is approved)
QNA_GPT_ENABLED=true
QNA_GPT_MODE=FAKE
QNA_GPT_PROVIDER=fake
QNA_GPT_MODEL=

# Semantic Analyzer 전용 설정. 비워두면 위 QNA_GPT_MODEL을 그대로 사용하며
# 답변 생성(DRAFT) 경로에는 어떤 영향도 없습니다.
# 의미 분류는 짧은 JSON 한 개를 돌려주는 작업이라 답변 생성용 모델보다
# 가벼운 설정으로 충분합니다. 실측: p50 5.8초 -> 3.5초, 출력 352 -> 225 토큰.
# 모델명은 QNA_GPT 허용 목록에 있는 값만 적용되고, 그 외에는 무시됩니다.
QNA_GPT_SEMANTIC_MODEL=
QNA_GPT_SEMANTIC_REASONING_EFFORT=
QNA_GPT_SEMANTIC_MAX_OUTPUT_TOKENS=

# 의미 분석 단계 자체의 on/off. 기본값 off.
OJE_SEMANTIC_ANALYZER_ENABLED=true
QNA_GPT_API_KEY=
QNA_GPT_COMPANY_APPROVED=false
QNA_GPT_PRIVACY_ENABLED=true
QNA_GPT_CONNECT_TIMEOUT_SECONDS=5
QNA_GPT_READ_TIMEOUT_SECONDS=30
QNA_GPT_TOTAL_TIMEOUT_SECONDS=40
QNA_GPT_MAX_RETRIES=2
QNA_GPT_RETRY_BACKOFF_SECONDS=0.5
QNA_GPT_REQUESTS_PER_MINUTE=30
QNA_GPT_DAILY_REQUEST_LIMIT=1000
QNA_GPT_PER_INQUIRY_LIMIT=5
QNA_GPT_REGENERATION_COOLDOWN_SECONDS=10
QNA_GPT_DAILY_COST_LIMIT_KRW=0
QNA_GPT_USD_KRW_RATE=1450
QNA_GPT_CANARY_PERCENTAGE=0
QNA_GPT_SHADOW_ENABLED=false
QNA_GPT_ALLOWED_PROVIDERS=openai
QNA_GPT_ALLOWED_MODELS=
QNA_GPT_PROMPT_CAPTURE_COMPANY_APPROVED=false
QNA_GPT_PROMPT_CAPTURE_SECURITY_APPROVED=false
QNA_GPT_PROMPT_VERSION=prompt-v1
QNA_GPT_PRIVACY_POLICY_VERSION=privacy-v1
QNA_GPT_VALIDATOR_POLICY_VERSION=validator-v1
QNA_GPT_COMPANY_TONE_VERSION=tone-v1
QNA_GPT_POLICY_VERSION=governance-v1

# Local application controls
QNA_LOCAL_AUTH_ENABLED=false
QNA_DEVELOPER_MODE=false
